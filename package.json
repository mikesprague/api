{
  "name": "api",
  "description": "Some API endpoints",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist/ && rimraf build/",
    "docs": "rimraf docs/ && nub run typedoc",
    "declarations": "rimraf types/ && tsc --emitDeclarationOnly",
    "env:load": "varlock load",
    "env:scan": "varlock scan",
    "github-trending-repos": "nub ./src/github-trending-repos.ts",
    "format": "oxfmt src --write",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "national-day": "nub ./src/national-day.ts",
    "posttypecheck": "nub run declarations",
    "test": "nub run format:check && nub run lint && nub run typecheck",
    "typecheck": "tsc --noEmit",
    "typedoc": "typedoc --out ./docs --entryPointStrategy expand ./src --excludeNotDocumented false --plugin typedoc-plugin-markdown --readme none",
    "typedoc-html": "typedoc --out ./dist/docs --entryPointStrategy expand ./src --excludeNotDocumented false --readme none"
  },
  "author": {
    "name": "Michael Sprague",
    "email": "mikesprague@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/mikesprague/api"
  },
  "engines": {
    "node": ">= 26.x",
    "npm": ">= 12.x"
  },
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "crawlee": "3.18.1",
    "dayjs": "1.11.23",
    "varlock": "1.17.0"
  },
  "devDependencies": {
    "@nubjs/nub": "0.7.5",
    "@nubjs/types": "0.7.5",
    "@types/node": "26.2.0",
    "cz-git": "1.13.2",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "6.1.3",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@7.0.2"
  },
  "overrides": {
    "nanoid": "6.0.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  },
  "allowScripts": {
    "@nubjs/nub": true
  }
}
